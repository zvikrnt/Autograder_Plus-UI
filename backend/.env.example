# Backend environment configuration template.
# Copy to backend/.env and fill in real values — never commit backend/.env.
#
# Dev defaults (if a key is omitted, settings.py falls back to permissive
# dev-friendly values). PRODUCTION must set every key below explicitly —
# see docs/RESTORE.md and docker-compose.prod.yml for how these are used.

# ===== Django core =====
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=*
# Production: ALLOWED_HOSTS=autograder.iitbh
CSRF_TRUSTED_ORIGINS=
# Production: CSRF_TRUSTED_ORIGINS=https://autograder.iitbh
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ===== CORS =====
# Production: CORS_ALLOW_ALL_ORIGINS=False, CORS_ALLOWED_ORIGINS=https://autograder.iitbh
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=

# ===== Database (Postgres) =====
POSTGRES_DB=autograder
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5400
DB_CONN_MAX_AGE=60
# Production: generate with `openssl rand -base64 32`, POSTGRES_HOST=db (compose service name)

# ===== Redis (broker, cache, Channels layer) =====
REDIS_URL=redis://localhost:6380/1
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_TASK_ALWAYS_EAGER=False
# Production: REDIS_URL=redis://redis:6379/1, CELERY_BROKER_URL=redis://redis:6379/0

# ===== MinIO / S3-compatible storage =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=autograder-bucket
MINIO_ENDPOINT=http://localhost:9012
# Production: generate real credentials, MINIO_ENDPOINT=http://minio:9000

# ===== Email (Resend) =====
RESEND_API_KEY=

# ===== Docker socket group mapping (production only) =====
# Output of `getent group docker` on the deployment VM — required so the
# non-root container user can use the mounted /var/run/docker.sock to
# launch grading containers (see backend/Dockerfile).
HOST_DOCKER_GID=999

# ===== Misc app settings =====
CODE_EXECUTION_TIMEOUT=10
MAX_CODE_LENGTH=50000
